{
  "name": "wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "mikro-orm": {
    "configPaths": ["./src/infra/database/mikro-orm.config.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "lint": "oxlint --ignore-pattern 'src/infra/database/migrations/**' src/ test/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:debug": "bun test --inspect-brk",
    "migration:create": "bun --env-file=.env --bun mikro-orm migration:create",
    "migration:create:blank": "bun --env-file=.env --bun mikro-orm migration:create --blank",
    "migration:up": "bun --env-file=.env --bun mikro-orm migration:up",
    "migration:down": "bun --env-file=.env --bun mikro-orm migration:down",
    "migration:list": "bun --env-file=.env --bun mikro-orm migration:list",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1146.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/testing": "12.2.0",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
